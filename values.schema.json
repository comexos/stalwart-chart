{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "domain": {
      "type": "string"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "type": [
            "integer",
            "string"
          ]
        },
        "targetMemoryUtilizationPercentage": {
          "type": [
            "integer",
            "string"
          ]
        },
        "metrics": {
          "type": "array"
        },
        "behavior": {
          "type": "object"
        }
      }
    },
    "coordinator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "",
            "nats",
            "redis",
            "kafka",
            "zenoh"
          ]
        },
        "nats": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "addresses": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "useTls": {
              "type": "boolean"
            },
            "authUsername": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string"
            },
            "passwordSecretKey": {
              "type": "string",
              "minLength": 1
            },
            "password": {
              "type": "string"
            }
          }
        },
        "redis": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string"
            }
          }
        },
        "kafka": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "brokers": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "groupId": {
              "type": "string"
            }
          }
        },
        "zenoh": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "config": {
              "type": "string"
            }
          }
        }
      }
    },
    "podManagementPolicy": {
      "enum": [
        "OrderedReady",
        "Parallel"
      ]
    },
    "podAntiAffinityPreset": {
      "enum": [
        "",
        "soft",
        "hard"
      ]
    },
    "config": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string",
          "minLength": 1
        }
      },
      "anyOf": [
        {
          "maxProperties": 0
        },
        {
          "required": [
            "@type"
          ]
        }
      ]
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "service": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "ipFamilyPolicy": {
          "enum": [
            "",
            "SingleStack",
            "PreferDualStack",
            "RequireDualStack"
          ]
        },
        "ipFamilies": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "enum": [
              "IPv4",
              "IPv6"
            ]
          }
        },
        "externalTrafficPolicy": {
          "enum": [
            "Local",
            "Cluster"
          ]
        },
        "ports": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$",
            "maxLength": 15
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "port",
              "containerPort",
              "protocol"
            ],
            "additionalProperties": false,
            "properties": {
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "containerPort": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "protocol": {
                "enum": [
                  "TCP"
                ]
              }
            }
          }
        }
      }
    },
    "updateStrategy": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "RollingUpdate",
            "OnDelete"
          ]
        }
      }
    },
    "startupProbe": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "successThreshold": {
          "const": 1
        }
      },
      "additionalProperties": false
    },
    "livenessProbe": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "successThreshold": {
          "const": 1
        }
      },
      "additionalProperties": false
    },
    "readinessProbe": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "successThreshold": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "management": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "servicePort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "recoveryMode": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "additionalLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "additionalAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "podLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "gatewayAPI": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "httpRoute": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "parentRefs": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "namespace": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sectionName": {
                    "type": "string",
                    "minLength": 1
                  },
                  "group": {
                    "const": "gateway.networking.k8s.io"
                  },
                  "kind": {
                    "const": "Gateway"
                  }
                },
                "additionalProperties": false
              }
            },
            "hostnames": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "backendPortName": {
              "enum": [
                "http"
              ]
            },
            "paths": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "type",
                  "value"
                ],
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "enum": [
                      "PathPrefix",
                      "Exact"
                    ]
                  },
                  "value": {
                    "type": "string",
                    "pattern": "^/"
                  }
                }
              }
            }
          }
        },
        "tcpRouteApiVersion": {
          "enum": [
            "gateway.networking.k8s.io/v1",
            "gateway.networking.k8s.io/v1alpha2"
          ]
        },
        "tcpRoutes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "parentRefs"
            ],
            "additionalProperties": false,
            "properties": {
              "parentRefs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "name"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "namespace": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sectionName": {
                      "type": "string",
                      "minLength": 1
                    },
                    "group": {
                      "const": "gateway.networking.k8s.io"
                    },
                    "kind": {
                      "const": "Gateway"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "annotations": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "dataStore": {
      "type": "object",
